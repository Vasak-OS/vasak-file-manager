{
	"name": "vasak-file-manager",
	"private": true,
	"version": "0.25.0",
	"type": "module",
	"scripts": {
		"dev": "bunx --bun vite",
		"build": "bunx vue-tsc --noEmit && bunx --bun vite build",
		"preview": "bunx --bun vite preview",
		"test": "bun test",
		"tauri": "tauri",
		"lint": "bunx --bun biome check .",
		"lint:fix": "bunx --bun biome check --write . && bunx --bun biome format --write .",
		"format": "bunx --bun biome format --write ."
	},
	"vasak": {
		"bibliotecasAtrasadas": {
			"typescript": "La 7 es el compilador nativo, y vue-tsc 3.3 no lo usa: subirla no cambia el typecheck de este repo y puede dejarlo sin compilador. Se saca cuando vue-tsc declare soporte de TypeScript 7.",
			"vite": "La 8 es un salto mayor del andamiaje de compilación: lo que hay que verificar —que la ventana empaquetada abra y cargue igual— no lo dice ninguna prueba automática, así que va en su propio PR. Se saca cuando se pruebe la aplicación compilada con vite 8 dentro de la sesión."
		}
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/api": "^2.12.1",
		"@tauri-apps/plugin-dialog": "~2.8.1",
		"@tauri-apps/plugin-log": "^2.10.0",
		"@tauri-apps/plugin-opener": "~2.7.0",
		"@tauri-apps/plugin-shell": "^2.4.0",
		"@tauri-apps/plugin-store": "^2.5.0",
		"@vasakgroup/plugin-config-manager": "^2.9.0",
		"@vasakgroup/plugin-drag-and-drop-wayland": "^2.1.1",
		"@vasakgroup/plugin-vicons": "^2.2.2",
		"@vasakgroup/plugin-vsk-contextual-menu": "^2.0.3",
		"@vasakgroup/plugin-vsk-journal": "^2.0.1",
		"@vasakgroup/tauri-plugin-i18n": "^2.3.1",
		"@vasakgroup/vue-libvasak": "^2.2.0",
		"@vue/devtools-api": "^8.2.1",
		"lodash.clonedeep": "^4.5.0",
		"path": "^0.12.7",
		"pinia": "^4.0.3",
		"url": "^0.11.4",
		"vue": "^3.5.43",
		"vue-virtual-scroller": "^3.0.5",
		"vue3-smooth-dnd": "^1.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@happy-dom/global-registrator": "^20.14.5",
		"@tailwindcss/postcss": "^4.3.3",
		"@tauri-apps/cli": "^2.12.1",
		"@types/lodash.clonedeep": "^4.5.9",
		"@types/node": "^26.6.4",
		"@vitejs/plugin-vue": "^6.0.9",
		"@vue/compiler-sfc": "^3.5.43",
		"@vue/test-utils": "^2.5.1",
		"postcss": "^8.5.28",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^7.3.6",
		"vue-tsc": "^3.3.11"
	}
}
