{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vasak-file-manager",
  "version": "0.23.2",
  "identifier": "ar.net.vasak.vasak-file-manager",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vasak File Manager",
        "width": 1280,
        "height": 720,
        "minWidth": 750,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; media-src 'self' asset: http://asset.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "resources": [
      "icons/icon.png"
    ],
    "active": true,
    "targets": "deb",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {}
      },
      "deb": {
        "desktopTemplate": "./vasak-file-manager.desktop.hbs",
        "depends": [
          "libc6",
          "libgcc-s1",
          "libcairo2",
          "libdbus-1-3",
          "libgdk-pixbuf-2.0-0",
          "libglib2.0-0t64",
          "libgtk-3-0t64",
          "libjavascriptcoregtk-4.1-0",
          "libsoup-3.0-0",
          "libwebkit2gtk-4.1-0",
          "vasak-desktop-settings",
          "vasak-accounts",
          "gvfs-backends",
          "udisks2",
          "dbus",
          "desktop-file-utils",
          "hicolor-icon-theme",
          "shared-mime-info",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ],
        "files": {}
      }
    },
    "icon": [
      "icons/icon.png",
      "icons/folder.svg"
    ]
  }
}
